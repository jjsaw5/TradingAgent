#!/usr/bin/env python3
"""
validate — check a desk artifact against its schema.

Agents must run this before writing any artifact. A watchlist that does not
validate is not a contract, and the monitor depends on it being one.

Usage:
    bin/validate state/watchlist/2026-08-14.json
    bin/validate state/pm/ledger.jsonl        # every line checked
    bin/validate --all                        # every artifact in state/ + examples/
    bin/validate --schema watchlist path/to/file.json

Schema is inferred from the path when not given explicitly:
    state/watchlist/*      -> watchlist          state/alerts/*        -> alert_state
    state/briefs/*         -> market_brief       state/flow/*          -> flow_candidates
    state/pm/playbook/*    -> pm_playbook        state/pm/tickets/*    -> pm_ticket
    state/pm/ledger.jsonl  -> pm_ledger_entry (one object per line)

Derived files with no contract (state/pm/calibration.json, state/pm/replay/*)
are skipped, not failed.
"""

import json
import sys
from pathlib import Path

try:
    from jsonschema import Draft202012Validator
except ImportError:
    sys.exit("validate: jsonschema is not installed. Run: pip install jsonschema")

ROOT = Path(__file__).resolve().parent.parent
SCHEMA_DIR = ROOT / "schemas"

# directory name -> schema
INFER_PARTS = {
    "watchlist": "watchlist",
    "alerts": "alert_state",
    "briefs": "market_brief",
    "flow": "flow_candidates",
    "playbook": "pm_playbook",
    "tickets": "pm_ticket",
}
# file stem -> schema (examples/, ledgers)
INFER_STEMS = {
    "ledger": "pm_ledger_entry",
    "pm_ledger": "pm_ledger_entry",
    "pm_ticket": "pm_ticket",
    "pm_playbook": "pm_playbook",
    "watchlist": "watchlist",
    "alert_state": "alert_state",
    "market_brief": "market_brief",
    "flow_candidates": "flow_candidates",
}


def infer_schema(path: Path) -> str | None:
    for part in path.parts[:-1]:
        if part in INFER_PARTS:
            return INFER_PARTS[part]
    # longest stem prefix wins so pm_ledger beats ledger and pm_ticket is unambiguous
    for key in sorted(INFER_STEMS, key=len, reverse=True):
        if path.stem.startswith(key):
            return INFER_STEMS[key]
    return None


def load_validator(schema_name: str):
    schema_path = SCHEMA_DIR / f"{schema_name}.schema.json"
    if not schema_path.exists():
        return None
    return Draft202012Validator(json.loads(schema_path.read_text()))


def errors_for(validator, instance, prefix: str = "") -> list[str]:
    errs = sorted(validator.iter_errors(instance), key=lambda e: list(e.path))
    return [
        f"{prefix}{'/'.join(str(p) for p in e.path) or '<root>'}: {e.message}" for e in errs
    ]


def validate(path: Path, schema_name: str) -> list[str]:
    validator = load_validator(schema_name)
    if validator is None:
        return [f"no such schema: {schema_name}.schema.json"]

    text = path.read_text()
    if path.suffix == ".jsonl":
        out = []
        for i, line in enumerate(text.splitlines(), start=1):
            if not line.strip():
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError as exc:
                out.append(f"line {i}: not valid JSON: {exc}")
                continue
            out.extend(errors_for(validator, obj, prefix=f"line {i}: "))
        return out

    try:
        instance = json.loads(text)
    except json.JSONDecodeError as exc:
        return [f"not valid JSON: {exc}"]
    return errors_for(validator, instance)


def main(argv: list[str]) -> int:
    schema_override = None
    if "--schema" in argv:
        i = argv.index("--schema")
        schema_override = argv[i + 1]
        del argv[i : i + 2]

    if "--all" in argv:
        targets = [
            p
            for d in ("state", "examples")
            for pattern in ("*.json", "*.jsonl")
            for p in (ROOT / d).rglob(pattern)
            if "raw" not in p.parts
        ]
    else:
        targets = [Path(a) for a in argv[1:]]

    if not targets:
        print(__doc__.strip())
        return 2

    failed = 0
    for path in sorted(targets):
        if not path.exists():
            print(f"MISSING  {path}")
            failed += 1
            continue

        schema_name = schema_override or infer_schema(path)
        if schema_name is None:
            print(f"SKIP     {path}  (no schema for this file)")
            continue

        errors = validate(path, schema_name)
        if errors:
            failed += 1
            print(f"FAIL     {path}  [{schema_name}]")
            for err in errors[:15]:
                print(f"           {err}")
            if len(errors) > 15:
                print(f"           ... and {len(errors) - 15} more")
        else:
            print(f"ok       {path}  [{schema_name}]")

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
