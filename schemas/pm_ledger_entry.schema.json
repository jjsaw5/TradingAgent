{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-desk/schemas/pm_ledger_entry.schema.json",
  "title": "Prediction-Market Ledger Entry",
  "description": "One line of state/pm/ledger.jsonl, appended by `pm settle` when a window's ticket resolves. Append-only, never edited: this file is the desk's measured track record and the input to the calibration gate. A correction is a new line that references the old one. Every evaluated window lands here, passes included — the model is graded on everything it said, not on the windows it liked.",
  "type": "object",
  "required": ["schema_version", "window_id", "ticket_ref", "asset", "market_ticker", "window_start", "window_end", "decided_at", "seconds_remaining", "p_model", "market_mid_up", "decision", "outcome", "pnl_paper_per_contract", "pnl_real"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "window_id": { "type": "string" },
    "ticket_ref": { "type": "string" },
    "asset": { "type": "string" },
    "market_ticker": { "type": "string" },
    "window_start": { "type": "string", "format": "date-time" },
    "window_end": { "type": "string", "format": "date-time" },
    "decided_at": { "type": "string", "format": "date-time" },
    "seconds_remaining": { "type": "integer" },
    "strike": { "type": ["number", "null"] },
    "spot": { "type": ["number", "null"] },
    "sigma_per_minute": { "type": ["number", "null"] },
    "p_model": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "market_mid_up": { "type": ["number", "null"] },
    "market_yes_ask": { "type": ["number", "null"] },
    "market_no_ask": { "type": ["number", "null"] },
    "decision": {
      "type": "object",
      "required": ["status", "side"],
      "properties": {
        "status": { "type": "string" },
        "side": { "enum": ["up", "down", null] },
        "limit_price": { "type": ["number", "null"] },
        "contracts": { "type": ["integer", "null"] },
        "stake": { "type": ["number", "null"] },
        "ev_per_contract": { "type": ["number", "null"] },
        "gate": { "type": ["string", "null"] }
      }
    },
    "execution": {
      "type": ["object", "null"],
      "properties": {
        "side": { "enum": ["up", "down"] },
        "price": { "type": "number" },
        "contracts": { "type": "integer" },
        "stake": { "type": "number" },
        "at": { "type": "string" }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["result", "settled_at"],
      "properties": {
        "result": { "enum": ["up", "down"] },
        "settlement_value": { "type": ["number", "null"] },
        "strike": { "type": ["number", "null"] },
        "kalshi_status": { "type": ["string", "null"] },
        "settled_at": { "type": "string", "format": "date-time" }
      }
    },
    "pnl_paper_per_contract": { "type": ["number", "null"], "description": "Result of the desk's decision at the decision ask, fees included, per $1 contract. Null when the decision was not play or paper." },
    "pnl_paper": { "type": ["number", "null"] },
    "pnl_real": { "type": ["number", "null"], "description": "Result of the client's reported fill. Null when nothing was recorded. Never inferred from the decision." },
    "brier_model": { "type": ["number", "null"] },
    "brier_market": { "type": ["number", "null"] },
    "corrects": { "type": ["string", "null"], "description": "window_id of an earlier line this one corrects. The earlier line stays." }
  }
}
