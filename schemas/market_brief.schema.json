{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-desk/schemas/market_brief.schema.json",
  "title": "Market Brief",
  "description": "Output of the market-brief agent. STRUCTURED DATA, NOT PROSE. The brief agent describes the tape; the desk turns that into the client's briefing. Keeping narrative out of here is what stops three agents producing three tones and two contradictory opinions in one morning.",
  "type": "object",
  "required": ["schema_version", "session_date", "generated_at", "stance", "gaps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "session_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "stance": {
      "type": "object",
      "required": ["read", "confidence", "invalidation"],
      "properties": {
        "read": { "enum": ["risk_on", "risk_off", "neutral", "two_sided", "no_read"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "summary": { "type": "string", "maxLength": 600 },
        "invalidation": { "type": "string", "description": "The observable that would falsify this read. Must be checkable intraday." }
      }
    },
    "overnight": {
      "type": "object",
      "properties": {
        "futures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": { "type": "string" },
              "change_pct": { "type": ["number", "null"] }
            }
          }
        },
        "asia_europe": { "type": ["string", "null"] },
        "rates": { "type": ["string", "null"] },
        "dollar": { "type": ["string", "null"] },
        "commodities": { "type": ["string", "null"] },
        "notable_gappers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ticker": { "type": "string" },
              "change_pct": { "type": ["number", "null"] },
              "reason": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "volatility": {
      "type": "object",
      "properties": {
        "vix": { "type": ["number", "null"] },
        "vix_change": { "type": ["number", "null"] },
        "term_structure": { "enum": ["contango", "backwardation", "flat", null] },
        "note": { "type": ["string", "null"], "description": "Whether the day favours buying or selling premium, and why." }
      }
    },
    "calendar": {
      "type": "array",
      "description": "Scheduled events that can move the tape today. Time is in the desk timezone.",
      "items": {
        "type": "object",
        "required": ["time", "event", "importance"],
        "properties": {
          "time": { "type": "string" },
          "event": { "type": "string" },
          "importance": { "enum": ["high", "medium", "low"] },
          "consensus": { "type": ["string", "null"] },
          "affects": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "earnings": {
      "type": "object",
      "properties": {
        "before_open": { "type": "array", "items": { "type": "string" } },
        "after_close": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sectors": {
      "type": "array",
      "description": "Sector tone from UW sector ETFs / sector tide. Leadership and laggards both matter — a flow name in a sector fighting the tape is a different trade than one with it.",
      "items": {
        "type": "object",
        "properties": {
          "sector": { "type": "string" },
          "tone": { "enum": ["strong", "mixed", "weak", null] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "index_levels": {
      "type": "object",
      "description": "Levels the desk will reference all day. GEX-derived levels are labelled as such — they are dealer-positioning inferences, not traded support.",
      "properties": {
        "SPX": { "$ref": "#/$defs/levels" },
        "QQQ": { "$ref": "#/$defs/levels" },
        "SPY": { "$ref": "#/$defs/levels" }
      }
    },
    "gaps": {
      "type": "array",
      "description": "REQUIRED, and an empty array must be a deliberate claim that nothing was missing. Anything the agent could not retrieve goes here. A brief with a silent hole is worse than a brief that says 'I could not get the econ calendar' — the client can act on a known gap.",
      "items": {
        "type": "object",
        "required": ["what", "why"],
        "properties": {
          "what": { "type": "string" },
          "why": { "type": "string" },
          "impact": { "type": "string", "description": "What this gap means the desk cannot say today." }
        }
      }
    }
  },
  "$defs": {
    "levels": {
      "type": "object",
      "properties": {
        "last": { "type": ["number", "null"] },
        "support": { "type": "array", "items": { "type": "number" } },
        "resistance": { "type": "array", "items": { "type": "number" } },
        "gamma_flip": { "type": ["number", "null"], "description": "Dealer gamma flip level. An inference from OI, not an observed price." },
        "max_pain": { "type": ["number", "null"] }
      }
    }
  }
}
