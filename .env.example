# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# A token that has been pasted anywhere other than a secret store — a commit, a
# log, a chat transcript, a screenshot — is already compromised. Rotate it
# rather than reasoning about who might have seen it.

# Unusual Whales API token. Required.
# Get it from https://unusualwhales.com/public-api (any paid API tier).
UW_API_TOKEN=

# Timezone the desk operates in. All schedule reasoning is done in this zone and
# converted to UTC only at the point a Routine cron is written.
DESK_TZ=America/New_York
